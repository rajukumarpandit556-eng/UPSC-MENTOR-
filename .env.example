# AI Provider Configurations
# Gemini API Key: Pre-configured in AI Studio for Gemini 3.8 Flash inference & Google Search grounding
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Optional OpenAI API Key: If you prefer OpenAI / Responses API
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o"

# Database Configuration: PostgreSQL connection string (e.g. postgresql://user:password@localhost:5432/upsc_mentor)
# If empty or not provided, an embedded durable file database in .data/upsc_mentor.db is automatically used
DATABASE_URL=""

# Authentication secret for signing user session tokens
AUTH_SECRET="upsc_mentor_secret_key_change_in_production"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
